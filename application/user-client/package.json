{
  "name": "user-client",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cy:open": "cypress open",
    "cypress": "docker compose up --build -d db-test backend-test && dotenv -e ../backend/.env.test start-server-and-test 'vite --port 5002 --host 0.0.0.0' http://localhost:5002 cy:open",
    "test": "docker compose up --build -d --wait db-test backend-test && npx dotenv -e ../backend/.env.test start-server-and-test 'vite --port 5002 --host 0.0.0.0' http://localhost:5002 cy:run",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.0.15",
    "@mui/icons-material": "^6.0.2",
    "@mui/material": "^6.1.5",
    "@tanstack/react-query": "^5.56.2",
    "axios": "^1.7.8",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "cypress": "^13.14.2",
    "eslint": "^9.9.0",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "start-server-and-test": "^2.0.9",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "winston": "^3.17.0"
  }
}
