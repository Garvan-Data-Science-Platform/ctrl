generator client {
  provider        = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  firstName           String               /// @encrypted
  middleName          String?              /// @encrypted
  lastName            String               /// @encrypted
  email               String               @unique /// @encrypted
  emailHash           String?              @unique /// @encryption:hash(email)
  password            String
  role                Role                 @default(Participant)
  organisations       Organisation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  agreedTermsAt       DateTime?
  profiles            ParticipantProfile[]
  auditLogs           AuditLog[]
  otpTokens           OTPToken[]
  passwordResetTokens PasswordResetToken[]
  lockedUntil         DateTime?
  retriesRemaining    Int                  @default(10)
  deleted             Boolean              @default(false)
}

enum ParticipantType {
  STANDARD
  GUARDIAN
  DEPENDENT_AGE
  DEPENDENT_OTHER
}

enum Role {
  OperatorAdmin
  Participant
  OrganisationAdmin
}

model ParticipantProfile {
  id               Int                    @id @default(autoincrement())
  individualId     String                 @unique @default(uuid()) // Note: the ID is generated by application code and is not a UUID
  firstName        String                  /// @encrypted
  firstNameHash    String?                 /// @encryption:hash(firstName)
  middleName       String?                 /// @encrypted
  lastName         String                  /// @encrypted
  lastNameHash     String?                 /// @encryption:hash(lastName)
  dob              DateTime               @db.Date
  mobile           String                  /// @encrypted
  addressLine      String                  /// @encrypted
  suburb           String                  /// @encrypted
  state            StateTerritory
  postcode         String                  /// @encrypted
  participantType  ParticipantType
  nextOfKin        AlternativeContact?
  preferredContact ContactMethod 
  studies          StudyParticipant[]
  familyId         Int                    @default(autoincrement())
  userId           Int?
  user             User?                  @relation(fields: [userId], references: [id])
  surveys          SurveyVersionAnswers[]
}

model StudyParticipant {
  participantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade)
  participantProfileId Int
  study                Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  studyId              Int
  participantNumber    Int                @default(0)
  participantId        String?
  deleted              Boolean            @default(false)

  @@id([participantProfileId, studyId])
}

model AlternativeContact {
  id                   Int                @id @default(autoincrement())
  firstName            String             /// @encrypted
  middleName           String?            /// @encrypted
  lastName             String             /// @encrypted
  mobile               String?            /// @encrypted
  email                String             /// @encrypted
  ParticipantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantProfileId Int                @unique
}

enum StateTerritory {
  ACT
  NSW
  NT
  QLD
  SA
  TAS
  VIC
  WA
}

enum ContactMethod {
  EMAIL
  MOBILE
  MAIL
}

model Organisation {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  mailerHost      String?
  mailerPort      Int?
  mailerUser      String?
  mailerPassword  String?
  primaryColour   String?
  secondaryColour String?
  redcapURL       String?
  redcapToken     String?
  elsaToken       String?
  logo            Bytes?
  tcLink          String  @default("https://garvan-data-science-platform.github.io/ctrl-docs/docs/terms-and-conditions")
  users           User[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Study {
  id                 Int                  @id @default(autoincrement())
  name               String               
  description        String?
  logo               Bytes?
  inviteEmailSubject String               @default("Invitation to CTRL - Dynamic Consent Platform")
  inviteEmailText    String               @default("You have been invited to register with CTRL dynamic consent platform.")
  surveys            SurveyVersion[]
  profiles           StudyParticipant[]
  invites            Invite[]
  deleted            Boolean            @default(false)
}

enum SurveyVersionStatus {
  DRAFT
  PUBLISHED
}

model SurveyVersion {
  id                   Int                    @id @default(autoincrement())
  versionNumber        Int
  /// ![PrismaJson.SurveyVersionData]
  data                 Json
  status               SurveyVersionStatus    @default(DRAFT)
  surveyVersionAnswers SurveyVersionAnswers[]
  study                Study                  @relation(fields: [studyId], references: [id], onDelete: Cascade)
  studyId              Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  publishedAt          DateTime?

  @@unique([studyId, versionNumber])
}

model SurveyVersionAnswers {
  id        Int                @id @default(autoincrement())
  version   SurveyVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId Int
  profile   ParticipantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId Int
  /// ![PrismaJson.SurveyAnswerData]
  answers   Json
  derived   String?
}

model Invite {
  id        String       @id @default(uuid())
  email     String       /// @encrypted
  emailHash String?      /// @encryption:hash(email)
  status    InviteStatus @default(PENDING)
  studyId   Int
  study     Study        @relation(fields: [studyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@unique([studyId, emailHash])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  FAILED_TO_SEND
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
}

enum AuditLogOperation {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        Int               @id @default(autoincrement())
  resource  String
  operation AuditLogOperation
  success   Boolean           @default(true)
  timestamp DateTime          @default(now())
  userId    Int?
  user      User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  meta      Json              
  requestBody String?          /// @encrypted
}

model OTPToken {
 id        String      @id @default(uuid())
 userId    Int
 user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 code      String
 expiresAt DateTime
}

model OTPToken {
 id        String      @id @default(uuid())
 userId    Int
 user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 code      String
 expiresAt DateTime
}
