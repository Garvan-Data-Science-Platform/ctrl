generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                 @id @default(autoincrement())
  firstName     String
  middleName    String?
  lastName      String
  email         String              @unique
  password      String
  role          String
  organisations Organisation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  profile       ParticipantProfile?
  surveys       SurveyParticipant[]
}

model ParticipantProfile {
  id                 Int                 @id @default(autoincrement())
  dob                DateTime            @db.Date
  participantID      String
  mobile             String
  addressLine        String
  suburb             String
  state              StateTerritory
  postcode           String
  isParentOrGuardian Boolean
  nextOfKin          AlternativeContact?
  onBehalfOf         OnBehalf?
  preferredContact   ContactMethod
  userId             Int                 @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model OnBehalf {
  id                   Int                @id @default(autoincrement())
  firstName            String
  lastName             String
  dob                  DateTime           @db.Date
  ParticipantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id])
  participantProfileId Int                @unique
}

model AlternativeContact {
  id                   Int                @id @default(autoincrement())
  firstName            String
  middleName           String?
  lastName             String
  mobile               String?
  email                String
  relationship         RelationshipType
  ParticipantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantProfileId Int                @unique
}

enum RelationshipType {
  PARENT
  GUARDIAN
  CHILD
  OTHER
}

enum StateTerritory {
  ACT
  NSW
  NT
  QLD
  SA
  TAS
  VIC
  WA
}

enum ContactMethod {
  EMAIL
  MOBILE
  MAIL
}

model Organisation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Study {
  id           Int                @id @default(autoincrement())
  surveys      SurveyVersion[]
}

enum SurveyVersionStatus {
  DRAFT
  PUBLISHED
}

model SurveyVersion {
  id                Int                 @id @default(autoincrement())
  versionNumber     Int                 
  /// ![PrismaJson.SurveyVersionData]
  data              Json
  status            SurveyVersionStatus @default(DRAFT)
  surveyParticipants SurveyParticipant[]
  study              Study              @relation(fields: [studyId], references: [id], onDelete: Cascade)
  studyId            Int @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model SurveyAnswers {
  id              Int           @id @default(autoincrement())
  participant     SurveyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId   Int
  /// ![PrismaJson.SurveyAnswerData]
  data      Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SurveyParticipant {
  id                 Int                @id @default(autoincrement())
  version            SurveyVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId          Int
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int
  answers            SurveyAnswers[]
}
