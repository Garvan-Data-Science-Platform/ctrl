generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                 @id @default(autoincrement())
  firstName     String
  middleName    String?
  lastName      String
  email         String              @unique
  password      String
  role          String
  organisations Organisation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  profile       ParticipantProfile?
  surveyAnsers  SurveyAnswers[]
}

model ParticipantProfile {
  id                 Int                 @id @default(autoincrement())
  dob                DateTime            @db.Date
  participantID      String
  mobile             String
  addressLine        String?
  suburb             String?
  state              StateTerritory?
  postcode           String?
  isParentOrGuardian Boolean
  nextOfKin          AlternativeContact?
  preferredContact   ContactMethod
  userID             Int                 @unique
  user               User                @relation(fields: [userID], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model AlternativeContact {
  id                   Int                @id @default(autoincrement())
  firstName            String
  middleName           String?
  lastName             String
  mobile               String?
  email                String             @unique
  relationship         RelationshipType
  ParticipantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantProfileId Int                @unique
}

enum RelationshipType {
  PARENT
  GUARDIAN
  CHILD
  OTHER
}

enum StateTerritory {
  ACT
  NSW
  NT
  QLD
  SA
  TAS
  VIC
  WA
}

enum ContactMethod {
  EMAIL
  MOBILE
  MAIL
}

model Organisation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SurveyVersion {
  id            Int      @id @default(autoincrement())
  versionNumber Int
  data          Json
  surveyAnsers  SurveyAnswers[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SurveyAnswers {
  id            Int      @id @default(autoincrement())
  version       SurveyVersion @relation(fields: [versionId], references: [id])
  versionId     Int
  user          User @relation(fields: [userId], references: [id])
  userId        Int
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}