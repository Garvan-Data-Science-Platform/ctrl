generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int                 @id @default(autoincrement())
  firstName     String
  middleName    String?
  lastName      String
  email         String              @unique
  password      String
  role          String
  organisations Organisation[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  profiles      ParticipantProfile[]
}

enum ParticipantType {
  STANDARD
  GUARDIAN
  DEPENDENT_AGE
  DEPENDENT_OTHER
}

model ParticipantProfile {
  id               Int                 @id @default(autoincrement())
  firstName        String
  middleName       String?
  lastName         String
  dob              DateTime            @db.Date
  mobile           String
  addressLine      String
  suburb           String
  state            StateTerritory
  postcode         String
  participantType  ParticipantType
  nextOfKin        AlternativeContact?
  preferredContact ContactMethod
  study            Study               @relation(fields: [studyId], references: [id], onDelete: Cascade)
  studyId          Int                 @default(1)
  familyId         Int                 @default(autoincrement())
  userId           Int?                
  user             User?               @relation(fields: [userId], references: [id])
  surveys          SurveyParticipant[]
}

model AlternativeContact {
  id                   Int                @id @default(autoincrement())
  firstName            String
  middleName           String?
  lastName             String
  mobile               String?
  email                String
  ParticipantProfile   ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  participantProfileId Int                @unique
}

enum StateTerritory {
  ACT
  NSW
  NT
  QLD
  SA
  TAS
  VIC
  WA
}

enum ContactMethod {
  EMAIL
  MOBILE
  MAIL
}

model Organisation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Study {
  id       Int                  @id @default(autoincrement())
  surveys  SurveyVersion[]
  profiles ParticipantProfile[]
}

enum SurveyVersionStatus {
  DRAFT
  PUBLISHED
}

model SurveyVersion {
  id                 Int                 @id @default(autoincrement())
  versionNumber      Int
  /// ![PrismaJson.SurveyVersionData]
  data               Json
  status             SurveyVersionStatus @default(DRAFT)
  surveyParticipants SurveyParticipant[]
  study              Study               @relation(fields: [studyId], references: [id], onDelete: Cascade)
  studyId            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model SurveyParticipant {
  id        Int                @id @default(autoincrement())
  version   SurveyVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId Int
  profile   ParticipantProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId Int
  /// ![PrismaJson.SurveyAnswerData]
  answers   Json
}

model Invite {
  id        Int      @id @default(autoincrement())
  email     String
  createdAt DateTime @default(now())
}