generator client {
  provider = "prisma-client-js"
  output   = "generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String   @unique
  role          String
  organisations Organisation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Organisation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
