{
  "name": "backend",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --external:express --external:cors",
    "start": "node dist/index.js",
    "type-check": "tsc",
    "test": "jest --detectOpenHandles",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "docs": "yarn run tsoa:routes && yarn run tsoa:spec"
  },
  "packageManager": "yarn@4.0.2",
  "dependencies": {
    "@tsoa/runtime": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "common": "workspace:^",
    "esbuild": "^0.20.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
