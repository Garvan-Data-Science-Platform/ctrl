{
  "entryFile": "src/index.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/controllers/*Controller.ts"],
  "spec": {
    "outputDirectory": ".",
    "specVersion": 3,
    "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "scopes": {
          "Participant": "Access to participant level resources",
          "OperatorAdmin": "Access to operator admin level resources",
          "OrganisationAdmin": "Access to organisation admin level resources"
        }
      }
    }
  },
  "routes": {
    "authenticationModule": "src/authentication.ts",
    "basePath": "/",
    "routesDir": "src"
  }
}
