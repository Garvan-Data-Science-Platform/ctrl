{
  "name": "ctrl-next",
  "packageManager": "yarn@4.0.2",
  "scripts": {
    "build": "yarn workspaces foreach --all run build",
    "start": "yarn workspaces foreach --all --parallel --interlaced run start",
    "dev": "yarn workspaces foreach --all --parallel --interlaced run dev",
    "type-check": "yarn workspaces foreach --all run type-check",
    "format": "yarn run prettier --write './application/**/*.(js|ts|jsx|tsx)'",
    "test": "yarn workspaces foreach --all --parallel run test",
    "lint": "eslint .",
    "build-docs": "yarn workspaces foreach --all run docs"
  },
  "workspaces": [
    "application/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
