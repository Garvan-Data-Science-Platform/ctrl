{
  "name": "ctrl",
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "build": "yarn workspaces foreach --all run build",
    "start": "yarn workspaces foreach --all --parallel --interlaced run start",
    "dev": "make db && yarn workspaces foreach --all --parallel --interlaced run dev",
    "type-check": "yarn workspaces foreach --all run type-check",
    "format": "yarn run prettier --write './application/**/*.(js|ts|jsx|tsx)'",
    "test": "yarn workspaces foreach --all run test",
    "lint": "eslint .",
    "build-docs": "yarn workspaces foreach --all run build-docs"
  },
  "workspaces": [
    "application/*"
  ],
  "private": true,
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.1.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^8.56.0",
    "json-schema-to-ts": "^3.1.1",
    "prettier": "^3.2.4",
    "start-server-and-test": "^2.0.9",
    "typescript": "^5.8.3",
    "vite-node": "^3.2.4"
  },
  "resolutions": {
    "axios": "^1.20.0",
    "body-parser@^2.2.0": "^2.2.1",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.29.3",
    "cross-spawn": "^7.0.5",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.8",
    "glob@^10": "^10.5.0",
    "handlebars": "^4.7.10",
    "@hapi/content": "^6.0.2",
    "@hapi/wreck": "^18.1.2",
    "js-yaml": "^5.2.2",
    "jws": "^3.2.3",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "mdast-util-to-hast@^13.0.0": "^13.2.1",
    "nanoid": "^3.3.20",
    "proxy-addr": "^2.0.8",
    "postcss": "^8.5.23",
    "qs": "^6.14.2",
    "router/path-to-regexp": "^8.4.0",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "validator": "^13.15.22",
    "vite-node/vite": "^7.3.5",
    "ws": "^8.21.0",
    "gray-matter": "npm:@11ty/gray-matter@^3.0.0"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.2.2",
    "tsx": "^4.23.0"
  }
}
