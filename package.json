{
  "name": "ctrl-next",
  "packageManager": "yarn@4.0.2",
  "scripts": {
    "build": "yarn workspaces foreach --all run build",
    "start": "yarn workspaces foreach --all --parallel --interlaced --jobs unlimited run start",
    "dev": "yarn workspaces foreach --all --parallel --interlaced --jobs unlimited run dev",
    "type-check": "yarn workspaces foreach --all run type-check",
    "format": "yarn run prettier --write './application/**/*.(js|ts|jsx|tsx)'",
    "lint": "eslint .",
    "test": "yarn workspaces foreach --all run test"
  },
  "workspaces": [
    "application/*"
  ],
  "pre-commit": [
    "format",
    "lint"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "pre-commit": "^1.2.2",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
